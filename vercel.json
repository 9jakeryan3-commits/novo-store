{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^www\\.novo-options\\.trade$"
        }
      ],
      "destination": "https://novo-options.trade/$1",
      "permanent": true
    },
    {
      "source": "/((?!api/|sitemap-old).*)",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?novo-aitrading\\.app$"
        }
      ],
      "destination": "https://novo-options.trade/$1",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/journal/:path*",
      "permanent": true
    },
    {
      "source": "/journal",
      "destination": "/journal/",
      "permanent": true
    },
    {
